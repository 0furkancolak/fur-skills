#!/usr/bin/env bash
set -euo pipefail

COMMAND="${1:-help}"
PROJECT_ROOT="$(pwd)"
PLANNING_DIR="$PROJECT_ROOT/.fur.planning"

print_help() {
  cat <<'HELP'
fur - simple personal AI agent workflow helper

Usage:
  fur help
  fur init [--gitignore|--no-gitignore] [--question-level low|normal|high] [--project-maturity new|established]
  fur workspace init
  fur workspace doctor
  fur refresh
  fur progress
  fur compact
  fur doctor

Commands:
  init                  Create .fur.planning; TTY prompts, non-TTY defaults to --gitignore/high/new
  workspace init         Create .fur.workspace/config.json in the current directory
  workspace doctor       Validate .fur.workspace/config.json
  refresh                Create a progress snapshot
  progress               Show current progress summary
  compact                Move old progress snapshots to progress/archive/ (token budget)
  doctor                 Check installation and local state
HELP
}

is_tty() {
  [ -t 0 ] && [ -t 1 ]
}

valid_question_level() {
  case "$1" in
    low | normal | high) return 0 ;;
    *) return 1 ;;
  esac
}

valid_project_maturity() {
  case "$1" in
    new | established) return 0 ;;
    *) return 1 ;;
  esac
}

prompt_choice() {
  local prompt="$1"
  local default="$2"
  local answer

  printf "%s [%s]: " "$prompt" "$default"
  read -r answer || true
  if [ -z "$answer" ]; then
    answer="$default"
  fi
  echo "$answer"
}

workspace_dir() {
  echo "$PROJECT_ROOT/.fur.workspace"
}

workspace_config() {
  echo "$(workspace_dir)/config.json"
}

find_workspace_config() {
  local dir="$PROJECT_ROOT"

  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.fur.workspace/config.json" ]; then
      echo "$dir/.fur.workspace/config.json"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

workspace_root_from_config() {
  local config="$1"
  dirname "$(dirname "$config")"
}

repo_registered_in_workspace() {
  local config="$1"

  python3 - "$config" "$PROJECT_ROOT" <<'PY' 2>/dev/null
import json
import os
import sys

config_path, project_root = sys.argv[1], os.path.realpath(sys.argv[2])
workspace_root = os.path.realpath(os.path.dirname(os.path.dirname(config_path)))

try:
    with open(config_path, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    sys.exit(1)

for repo in data.get("repositories", []):
    path = repo.get("path")
    if not path:
        continue
    repo_root = os.path.realpath(os.path.join(workspace_root, path))
    if repo_root == project_root:
        print(repo.get("id") or path)
        sys.exit(0)

sys.exit(1)
PY
}

ensure_planning_dirs() {
  mkdir -p \
    "$PLANNING_DIR/tasks/backlog" \
    "$PLANNING_DIR/tasks/ready" \
    "$PLANNING_DIR/tasks/done" \
    "$PLANNING_DIR/plans" \
    "$PLANNING_DIR/progress" \
    "$PLANNING_DIR/progress/archive" \
    "$PLANNING_DIR/context" \
    "$PLANNING_DIR/context/archive"
}

write_planning_files() {
  cat > "$PLANNING_DIR/README.md" <<'EOF_README'
# .fur.planning

Project-local planning workspace for AI agents.

## Layout

```txt
tasks/backlog/  Draft tasks (not yet ready for implementation)
tasks/ready/    Ready-to-implement tasks (prioritized)
tasks/done/     Completed tasks (kept for reference)
plans/          Implementation plans (include parallel slices / worktree notes when needed)
progress/       Progress snapshots (fur compact -> progress/archive/)
context/        Project context: MCP, issue tracker, verification, domain notes
```

## Rules

- Keep secrets out of this folder.
- External tracker writes require clear `.fur.workspace/config.json` permission.
- Local markdown is the fallback when MCP/Jira/GitHub is unavailable.
- Prefer loading `progress/latest.md` in agents; do not paste full task history into chat.
- Link to task files instead of pasting their full contents.
- Archive long context digests to `context/archive/` with a short summary left in place.
EOF_README

  if [ ! -f "$PLANNING_DIR/context/issue-tracker.md" ]; then
    cat > "$PLANNING_DIR/context/issue-tracker.md" <<'EOF_ISSUE'
# Issue Tracker

## Mode

local-markdown

## Supported Modes

- local-markdown: Tasks stored as markdown files in `.fur.planning/tasks/`
- jira: Sync with Jira via MCP (requires configuration)
- github: Sync with GitHub Issues via MCP (requires configuration)
- mixed: Local markdown with selective external sync

## Rules

- External writes are allowed only when `.fur.workspace/config.json` selects the tracker/repo unambiguously and the relevant `writeAllowed` flag is true.
- Reading external issues for context is allowed when tools are available.
- If external tracker is unavailable, write local markdown task.
- Never fake an external issue ID.
EOF_ISSUE
  fi

  if [ ! -f "$PLANNING_DIR/context/mcp.md" ]; then
    cat > "$PLANNING_DIR/context/mcp.md" <<'EOF_MCP'
# MCP Context

Document available MCP sources here.

Examples:

- Jira / Atlassian
- GitHub
- Context7
- Browser / Playwright
- Figma

## Rules

- Read-only context gathering is allowed when tools are configured.
- Write actions require clear `.fur.workspace/config.json` permission.
- If MCP is unavailable, continue with local markdown.
EOF_MCP
  fi

  if [ ! -f "$PLANNING_DIR/context/verification.md" ]; then
    cat > "$PLANNING_DIR/context/verification.md" <<'EOF_VERIFICATION'
# Verification

Update these commands per project.

```bash
pnpm typecheck
pnpm lint
pnpm test
```

## Rules

- Run targeted checks first (e.g., lint only changed files).
- Do not claim done when verification fails.
- If a command is missing, explain it and suggest an alternative.
- Always run verification before marking a task as done.
EOF_VERIFICATION
  fi
}

add_gitignore_entry() {
  local gitignore_file="$PROJECT_ROOT/.gitignore"

  touch "$gitignore_file"

  if ! grep -qxF ".fur.planning/" "$gitignore_file"; then
    {
      echo ""
      echo "# Fur agent planning workspace"
      echo ".fur.planning/"
    } >> "$gitignore_file"
  fi
}

write_config() {
  local gitignore="$1"
  local question_level="$2"
  local project_maturity="$3"
  local created_at
  created_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  cat > "$PLANNING_DIR/config.json" <<EOF_CONFIG
{
  "version": 1,
  "planningDir": ".fur.planning",
  "gitignore": ${gitignore},
  "localTaskMode": "local-markdown",
  "questionLevel": "${question_level}",
  "projectMaturity": "${project_maturity}",
  "questionPolicy": {
    "askBeforeSplittingLargeTasks": true,
    "askWhenAcceptanceCriteriaMissing": true,
    "askWhenTrackerConfigAmbiguous": true,
    "askWhenRiskIsHigh": true
  },
  "createdAt": "${created_at}"
}
EOF_CONFIG
}

report_workspace_hint() {
  local config

  if config="$(find_workspace_config)"; then
    local registered=""
    registered="$(repo_registered_in_workspace "$config" || true)"
    echo "Workspace config found: $config"
    if [ -n "$registered" ]; then
      echo "Workspace repo id: $registered"
    else
      echo "This repo is not registered in the workspace config yet."
      echo "Add a repositories[] entry for: $PROJECT_ROOT"
    fi
  else
    echo "No parent .fur.workspace/config.json found."
    echo "For tracker-aware multi-repo work, run from the workspace root:"
    echo "  fur workspace init"
  fi
}

cmd_init() {
  local mode=""
  local question_level=""
  local project_maturity=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --gitignore | --no-gitignore)
        mode="$1"
        shift
        ;;
      --question-level)
        if [ "$#" -lt 2 ]; then
          echo "Missing value for --question-level"
          exit 1
        fi
        question_level="${2:-}"
        shift 2
        ;;
      --project-maturity)
        if [ "$#" -lt 2 ]; then
          echo "Missing value for --project-maturity"
          exit 1
        fi
        project_maturity="${2:-}"
        shift 2
        ;;
      *)
        echo "Unknown init option: $1"
        echo "Usage:"
        echo "  fur init [--gitignore|--no-gitignore] [--question-level low|normal|high] [--project-maturity new|established]"
        exit 1
        ;;
    esac
  done

  if [ -z "$mode" ]; then
    if is_tty; then
      local git_answer
      git_answer="$(prompt_choice "Ignore .fur.planning in git? yes/no" "yes")"
      case "$git_answer" in
        y | yes | Y | YES) mode="--gitignore" ;;
        n | no | N | NO) mode="--no-gitignore" ;;
        *)
          echo "Invalid answer: $git_answer"
          exit 1
          ;;
      esac
    else
      mode="--gitignore"
    fi
  fi

  if [ -z "$project_maturity" ]; then
    if is_tty; then
      project_maturity="$(prompt_choice "Project maturity (new/established)" "new")"
    else
      project_maturity="new"
    fi
  fi

  if ! valid_project_maturity "$project_maturity"; then
    echo "Invalid project maturity: $project_maturity"
    echo "Expected: new or established"
    exit 1
  fi

  if [ -z "$question_level" ]; then
    if is_tty; then
      local default_level="high"
      if [ "$project_maturity" = "established" ]; then
        default_level="normal"
      fi
      question_level="$(prompt_choice "Question level (low/normal/high)" "$default_level")"
    else
      if [ "$project_maturity" = "established" ]; then
        question_level="normal"
      else
        question_level="high"
      fi
    fi
  fi

  if ! valid_question_level "$question_level"; then
    echo "Invalid question level: $question_level"
    echo "Expected: low, normal, or high"
    exit 1
  fi

  ensure_planning_dirs
  write_planning_files

  if [ "$mode" = "--gitignore" ]; then
    add_gitignore_entry
    write_config "true" "$question_level" "$project_maturity"
    echo "Initialized .fur.planning and added it to .gitignore"
  else
    write_config "false" "$question_level" "$project_maturity"
    echo "Initialized .fur.planning without adding it to .gitignore"
  fi

  echo "Question level: $question_level"
  echo "Project maturity: $project_maturity"

  echo ""
  report_workspace_hint
}

cmd_workspace_init() {
  local dir
  dir="$(workspace_dir)"
  mkdir -p "$dir"

  local config
  config="$(workspace_config)"

  if [ -f "$config" ]; then
    echo "Workspace config already exists:"
    echo "$config"
    return 0
  fi

  local created_at
  created_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  cat > "$config" <<EOF_CONFIG
{
  "version": 1,
  "defaultTaskSource": "local",
  "writePolicy": "config-allowed",
  "repositories": [],
  "createdAt": "${created_at}"
}
EOF_CONFIG

  echo "Workspace config written:"
  echo "$config"
  echo ""
  echo "Add repository entries under repositories[] before using tracker-aware imports or external writes."
}

cmd_workspace_doctor() {
  local config
  config="$(workspace_config)"

  if [ ! -f "$config" ]; then
    echo "No workspace config found:"
    echo "$config"
    echo "Run: fur workspace init"
    exit 1
  fi

  python3 - "$config" <<'PY'
import json
import os
import sys
from collections import defaultdict

config_path = sys.argv[1]
workspace_root = os.path.dirname(os.path.dirname(os.path.realpath(config_path)))

print("Fur workspace doctor")
print("====================")
print("")
print(f"Workspace: {workspace_root}")
print(f"Config: {config_path}")
print("")

try:
    with open(config_path, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as exc:
    print(f"Invalid JSON: {exc}")
    sys.exit(1)

errors = []
warnings = []
repos = data.get("repositories")
if not isinstance(repos, list):
    errors.append("repositories must be an array")
    repos = []

ids = defaultdict(list)
jira_keys = defaultdict(list)
github_pairs = defaultdict(list)

for idx, repo in enumerate(repos):
    label = repo.get("id") or f"repositories[{idx}]"
    ids[repo.get("id")].append(label)

    path = repo.get("path")
    if not path:
      errors.append(f"{label}: missing path")
    else:
      abs_path = os.path.join(workspace_root, path)
      if not os.path.isdir(abs_path):
          errors.append(f"{label}: path does not exist: {path}")

    github = repo.get("github")
    if isinstance(github, dict):
        owner = github.get("owner")
        name = github.get("repo")
        mcp = github.get("mcp")
        if owner and name:
            github_pairs[(owner, name)].append(label)
        else:
            warnings.append(f"{label}: github owner/repo incomplete")
        if not mcp:
            warnings.append(f"{label}: github.mcp missing")

    jira = repo.get("jira")
    if isinstance(jira, dict):
        keys = jira.get("projectKeys") or []
        if not keys:
            warnings.append(f"{label}: jira.projectKeys empty")
        for key in keys:
            jira_keys[str(key).upper()].append(label)
        if not jira.get("mcp"):
            warnings.append(f"{label}: jira.mcp missing")

for repo_id, labels in ids.items():
    if repo_id and len(labels) > 1:
        errors.append(f"duplicate repository id: {repo_id}")

for key, labels in jira_keys.items():
    if len(labels) > 1:
        errors.append(f"duplicate Jira project key {key}: {', '.join(labels)}")

for pair, labels in github_pairs.items():
    if len(labels) > 1:
        errors.append(f"duplicate GitHub repository {pair[0]}/{pair[1]}: {', '.join(labels)}")

print(f"Repositories: {len(repos)}")
print(f"Default task source: {data.get('defaultTaskSource', 'local')}")
print(f"Write policy: {data.get('writePolicy', 'config-allowed')}")
print("")

if errors:
    print("Errors:")
    for error in errors:
        print(f"- {error}")
else:
    print("Errors: none")

print("")
if warnings:
    print("Warnings:")
    for warning in warnings:
        print(f"- {warning}")
else:
    print("Warnings: none")

sys.exit(1 if errors else 0)
PY
}

count_md() {
  local dir="$1"

  if [ ! -d "$dir" ]; then
    echo "0"
    return
  fi

  find "$dir" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' '
}

cmd_refresh() {
  ensure_planning_dirs

  local timestamp
  timestamp="$(date +%Y%m%d-%H%M%S)"

  local snapshot="$PLANNING_DIR/progress/$timestamp.md"

  {
    echo "# Fur Progress Snapshot"
    echo ""
    echo "Date: $(date)"
    echo "Project: $PROJECT_ROOT"
    echo ""
    echo "## Git"
    echo ""

    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo "- Branch: $(git branch --show-current 2>/dev/null || echo unknown)"
      echo "- Commit: $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
      echo ""
      echo "### Status"
      echo ""
      echo '```txt'
      git status --short || true
      echo '```'
    else
      echo "Not a git repository."
    fi

    echo ""
    echo "## Counts"
    echo ""
    echo "- Backlog: $(count_md "$PLANNING_DIR/tasks/backlog")"
    echo "- Ready: $(count_md "$PLANNING_DIR/tasks/ready")"
    echo "- Done: $(count_md "$PLANNING_DIR/tasks/done")"
    echo "- Plans: $(count_md "$PLANNING_DIR/plans")"
    echo ""
    echo "## Tracker sync"
    echo ""
    local workspace_config_path
    workspace_config_path="$(find_workspace_config || true)"
    if [ -n "$workspace_config_path" ]; then
      echo "- Workspace config: $workspace_config_path"
      local workspace_repo_id
      workspace_repo_id="$(repo_registered_in_workspace "$workspace_config_path" || true)"
      if [ -n "$workspace_repo_id" ]; then
        echo "- Workspace repo id: $workspace_repo_id"
      else
        echo "- Workspace repo id: not registered"
      fi
    else
      echo "- Workspace config: not found"
    fi
    echo ""
    echo "## Latest ready tasks"
    echo ""
    find "$PLANNING_DIR/tasks/ready" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort | tail -10 | sed 's#^#- #' || true
  } > "$snapshot"

  ln -sfn "$snapshot" "$PLANNING_DIR/progress/latest.md"

  echo "Progress snapshot written:"
  echo "$snapshot"
}

cmd_progress() {
  if [ ! -d "$PLANNING_DIR" ]; then
    echo "No .fur.planning found. Run:"
    echo "  fur init --gitignore"
    echo "or:"
    echo "  fur init --no-gitignore"
    exit 1
  fi

  echo "Fur progress"
  echo "============"
  echo ""
  echo "- Backlog: $(count_md "$PLANNING_DIR/tasks/backlog")"
  echo "- Ready: $(count_md "$PLANNING_DIR/tasks/ready")"
  echo "- Done: $(count_md "$PLANNING_DIR/tasks/done")"
  echo "- Plans: $(count_md "$PLANNING_DIR/plans")"
  echo ""
  echo "Tracker sync"
  echo "------------"
  report_workspace_hint
  echo ""

  if [ -f "$PLANNING_DIR/progress/latest.md" ]; then
    echo "Latest snapshot:"
    echo "$PLANNING_DIR/progress/latest.md"
    echo ""
    sed -n '1,160p' "$PLANNING_DIR/progress/latest.md"
  else
    echo "No progress snapshot yet. Run:"
    echo "  fur refresh"
  fi
}

cmd_compact() {
  local prog="$PLANNING_DIR/progress"
  if [ ! -d "$prog" ]; then
    echo "No progress directory. Run: fur init --gitignore"
    exit 1
  fi

  mkdir -p "$prog/archive"

  local keep="${FUR_PROGRESS_KEEP:-8}"
  local protected=""
  if [ -L "$prog/latest.md" ]; then
    protected="$(readlink "$prog/latest.md")"
    case "$protected" in
      /*) ;;
      *) protected="$prog/$protected" ;;
    esac
  fi

  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/furcompact.XXXXXX")"

  local total
  total=0
  while true; do
    find "$prog" -maxdepth 1 -type f -name '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.md' 2>/dev/null | sort >"$tmp" || true
    total=$(wc -l <"$tmp" | tr -d ' ')
    if [ -z "$total" ]; then
      total=0
    fi
    if [ "$total" -le "$keep" ]; then
      break
    fi

    local moved="false"
    while IFS= read -r fpath; do
      [ -n "$fpath" ] || continue
      if [ -n "$protected" ] && [ "$fpath" = "$protected" ]; then
        continue
      fi
      mv "$fpath" "$prog/archive/"
      moved="true"
      break
    done <"$tmp"

    if [ "$moved" != "true" ]; then
      echo "Could not compact further (only protected snapshot left?)."
      break
    fi
  done

  rm -f "$tmp"
  echo "Compaction complete (keep=${keep})."
}

cmd_doctor() {
  echo "Fur doctor"
  echo "=========="
  echo ""
  echo "Project: $PROJECT_ROOT"
  echo "Planning dir: $PLANNING_DIR"
  echo ""

  if command -v fur >/dev/null 2>&1; then
    echo "fur CLI: $(command -v fur)"
  else
    echo "fur CLI: not found in PATH"
  fi

  echo ""

  for d in "$HOME/.claude/skills" "$HOME/.agents/skills" "$HOME/.cursor/skills"; do
    echo "## $d"
    if [ -d "$d" ]; then
      find -L "$d" -maxdepth 2 -name SKILL.md 2>/dev/null | sort || true
    else
      echo "missing"
    fi
    echo ""
  done

  echo "## Non-fur skills"
  find "$HOME/.claude/skills" "$HOME/.agents/skills" "$HOME/.cursor/skills" \
    -mindepth 1 -maxdepth 1 -type d ! -name 'fur-*' 2>/dev/null | sort || true

  echo ""
  echo "## GSD leftovers"
  find "$HOME/.claude/skills" "$HOME/.agents/skills" "$HOME/.cursor/skills" "$HOME/.codex/skills" \
    -maxdepth 2 -type d -name 'gsd-*' 2>/dev/null | sort || true
}

case "$COMMAND" in
  help | --help | -h)
    print_help
    ;;
  init)
    shift
    cmd_init "$@"
    ;;
  workspace)
    shift
    case "${1:-}" in
      init)
        cmd_workspace_init
        ;;
      doctor)
        cmd_workspace_doctor
        ;;
      *)
        echo "Usage:"
        echo "  fur workspace init"
        echo "  fur workspace doctor"
        exit 1
        ;;
    esac
    ;;
  refresh)
    cmd_refresh
    ;;
  progress)
    cmd_progress
    ;;
  compact)
    cmd_compact
    ;;
  doctor)
    cmd_doctor
    ;;
  *)
    echo "Unknown command: $COMMAND"
    echo ""
    print_help
    exit 1
    ;;
esac
